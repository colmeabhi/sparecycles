# Copy this file to .env and change the values:
#   cp .env.example .env
# The binaries and Docker Compose read .env automatically.
# Do not commit .env. For CI, add the same names as GitHub secrets or variables.

# --- Shared ---------------------------------------------------------------

# Volunteers must send this token to register. Use a long random value.
# If it is empty, the coordinator accepts every volunteer.
SC_VOLUNTEER_TOKEN=change-me

# Log level: debug, info, warn or error.
SC_LOG_LEVEL=info

# --- Coordinator ----------------------------------------------------------

# Unique ID of this coordinator. The highest alive ID is the leader.
SC_NODE_ID=1
# gRPC address for clients, volunteers and other coordinators.
SC_LISTEN_ADDR=:7400
# Other coordinators as id=host:port, comma separated. Empty for one coordinator.
SC_PEERS=
# HTTP address for /metrics (Prometheus) and /healthz.
SC_METRICS_ADDR=:9400
# Time a volunteer has to finish a unit before the unit goes to another volunteer.
SC_LEASE_DURATION=3m
# Number of volunteers that run each unit (for majority voting).
SC_VOTE_REPLICAS=3

# --- Volunteer and client -------------------------------------------------

# Coordinator addresses, comma separated.
SC_COORDINATORS=localhost:7400
# Optional volunteer name for logs. Default: the host name.
SC_VOLUNTEER_NAME=
# Optional resource overrides. Defaults: all CPU cores, unknown memory, speed 1.0.
SC_CPU_CORES=
SC_MEMORY_MB=
SC_SPEED_SCORE=
