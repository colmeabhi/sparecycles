# Copy this file to .env and change the values:
#   cp .env.example .env
# The binaries and Docker Compose read .env automatically.
# Do not commit .env. For CI, add the same names as GitHub secrets or variables.

# --- Shared ---------------------------------------------------------------

# Volunteers must send this token to register. Use a long random value.
# If it is empty (and SC_VOLUNTEER_TOKENS is empty), the coordinator accepts every volunteer.
SC_VOLUNTEER_TOKEN=change-me

# Log level: debug, info, warn or error.
SC_LOG_LEVEL=info

# SWIM gossip failure detector (coordinators and volunteers).
# Time between two probes.
SC_GOSSIP_INTERVAL=1s
# Wait for a direct ack. Must be less than SC_GOSSIP_INTERVAL.
SC_GOSSIP_PING_TIMEOUT=400ms
# Time from suspect to dead.
SC_GOSSIP_SUSPECT_TIMEOUT=5s
# Members asked to ping a target that did not answer.
SC_GOSSIP_INDIRECT=3

# --- Coordinator ----------------------------------------------------------

# Unique ID of this coordinator. The highest alive ID is the leader.
SC_NODE_ID=1
# gRPC address for clients, volunteers and other coordinators.
SC_LISTEN_ADDR=:7400
# Address that other nodes use to reach this coordinator. Default: 127.0.0.1 and the listen port.
SC_ADVERTISE_ADDR=
# Other coordinators as id=host:port, comma separated. Empty for one coordinator.
SC_PEERS=
# Leader election (Bully with terms). The leader sends a heartbeat this often.
SC_ELECTION_HEARTBEAT=500ms
# A coordinator that hears no leader for this long starts an election.
# Must be more than 2 times SC_ELECTION_HEARTBEAT. The leader lease is the timeout minus one heartbeat.
SC_ELECTION_TIMEOUT=2s
# Time the leader waits for the backups for one task-table change. With 3 coordinators,
# 1 backup must have the change before the leader confirms it.
SC_REPLICATION_TIMEOUT=1s
# HTTP address for /metrics (Prometheus) and /healthz.
SC_METRICS_ADDR=:9400
# Time a volunteer has to finish a unit before the unit goes to another volunteer.
SC_LEASE_DURATION=3m
# Number of volunteers that run each unit (for majority voting).
SC_VOTE_REPLICAS=3
# Per-volunteer tokens, comma separated, as name=token (or only token).
# If set, it replaces SC_VOLUNTEER_TOKEN on the coordinator.
SC_VOLUNTEER_TOKENS=
# Task signing private key (base64). Make one with: make keys
# Every coordinator needs the same key. Empty means tasks are not signed. Keep it secret.
SC_SIGNING_KEY=

# --- Volunteer and client -------------------------------------------------

# Coordinator addresses, comma separated. Calls go to the leader; the others are tried when it fails.
# The client default (when this is empty) is localhost:7400 to 7403: one local coordinator, or the
# 3 Docker Compose coordinators. The volunteer default is localhost:7400.
SC_COORDINATORS=localhost:7400
# Optional volunteer name for logs. Default: the host name.
SC_VOLUNTEER_NAME=
# Coordinators' task signing public key (base64), from: make keys
# Empty means task signatures are not checked.
SC_SIGNING_PUBLIC_KEY=
# Optional resource overrides. Defaults: all CPU cores, unknown memory, speed 1.0.
SC_CPU_CORES=
SC_MEMORY_MB=
SC_SPEED_SCORE=
# Volunteer gossip listen address. Default ":0" picks a free port. "off" turns gossip off
# (use "off" behind a home router; then only the lease finds a failure).
SC_GOSSIP_ADDR=
# Host that others use to reach this volunteer. Default 127.0.0.1. "hostname" uses the machine name.
SC_GOSSIP_HOST=
